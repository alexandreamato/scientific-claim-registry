# SCR — example environment. Copy to .env and fill in. NEVER commit your real .env (gitignored).
# Resolution order in code: SCR_* (canonical) → conventional vendor name (back-compat) → ~/.config file.

# ── LLM (the registry is provider-agnostic; one key is enough) ────────────────
# Default/preferred backend is OpenRouter → Opus 4.8 (see R-AI-6).
SCR_OPENROUTER_TOKEN=
# Optional alternatives (used only if OpenRouter is absent):
# SCR_ANTHROPIC_TOKEN=
# SCR_OPENAI_TOKEN=
# Force a specific model/provider (optional):
# SCR_LLM_MODEL=anthropic/claude-sonnet-4.6
# SCR_LLM_PROVIDER=openrouter

# ── Deploy of the OFFICIAL instance (maintainer only — not needed to run locally) ──
# rsync target for your instance; a fresh clone can build everything WITHOUT this.
SCR_DEPLOY_SSH=user@example.com:/path/to/public_html/
# Cloudflare token to purge the edge cache after deploy (official instance only):
SCR_CF_TOKEN=

# ── Optional: local high-recall retrieval (the author's curated `bib`; not redistributable) ──
# If a `bib serve` instance is running, the loop uses it first, else falls back to Europe PMC.
# BIB_API=http://127.0.0.1:8900
